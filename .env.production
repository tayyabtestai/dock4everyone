# ─────────────────────────────────────────────────────────────────────────────
# Committed build-time Supabase config for hosted (Lovable) PRODUCTION builds.
#
# PUBLIC values only — the project URL and the publishable/anon key. Safe to
# commit: the anon key is meant to ship in the browser bundle, and all access is
# enforced by Supabase Row-Level Security (RLS). The SECRET service-role key is
# never committed; it is supplied by the server environment only.
#
# Points at wxommwxeqfapqdrkrzja — the Supabase project connected to Lovable.
# A matching public fallback is also hardcoded in
# src/integrations/supabase/client.ts so the app connects even if the platform
# ignores committed .env files. Local dev uses .env (gitignored).
# ─────────────────────────────────────────────────────────────────────────────

# Browser (Vite build-time replacement)
VITE_SUPABASE_URL=https://wxommwxeqfapqdrkrzja.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_A2tT4yolfTupImWpVOBncw_p9CmRU9I
VITE_SUPABASE_PROJECT_ID=wxommwxeqfapqdrkrzja

# Server (SSR / process.env fallback)
SUPABASE_URL=https://wxommwxeqfapqdrkrzja.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_A2tT4yolfTupImWpVOBncw_p9CmRU9I
SUPABASE_PROJECT_ID=wxommwxeqfapqdrkrzja
