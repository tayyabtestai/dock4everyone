# ─────────────────────────────────────────────────────────────────────────────
# Supabase connection for the Dock app.
#
# 1. Copy this file to `.env` for local development:  cp .env.example .env
# 2. Fill in the real values from your Supabase project
#    (Supabase Dashboard → Project Settings → API), or copy them from the
#    original project's .env.
# 3. In Lovable, set these SAME variables in the project's environment / secret
#    settings — or use "Connect Supabase in Lovable Cloud". A Lovable project
#    with these missing throws: "Missing Supabase environment variable(s)…".
#
# The app reads the VITE_* vars in the browser (Vite build-time replacement) and
# the unprefixed vars during server-side rendering (SSR). Set BOTH groups.
# `.env` itself is gitignored — never commit real keys.
# ─────────────────────────────────────────────────────────────────────────────

# --- Browser (Vite build-time) ---
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
VITE_SUPABASE_PROJECT_ID=your-project-ref

# --- Server (SSR / process.env) ---
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
SUPABASE_PROJECT_ID=your-project-ref
